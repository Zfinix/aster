{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aster",
  "version": "0.4.0",
  "identifier": "dev.aster.desktop",
  "build": {
    "beforeDevCommand": "bun run cli:debug && bun run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run sidecar && bun run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Aster",
        "width": 1280,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/aster-cli"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwQUI0MjQzMjkzNkY2MzEKUldReDlqWXBRMEtyZ1BqUEF3Tll3NWxaRVdacWdDaVVTeU5GMjc4TWJmSFY4TEhUTTZnTlVNbHgK",
      "endpoints": [
        "https://github.com/Zfinix/aster/releases/latest/download/latest.json"
      ]
    }
  }
}
