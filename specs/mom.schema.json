{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aster.dev/schemas/mom/0.1/mom.schema.json",
  "title": "MoM manifest",
  "description": "Model Manifest: a model policy manifest of named model setups and switch rules for AI tools.",
  "type": "object",
  "required": [
    "mom",
    "models",
    "start-with"
  ],
  "properties": {
    "mom": {
      "type": "string",
      "pattern": "^0\\.1$",
      "description": "Manifest format version."
    },
    "name": {
      "type": "string",
      "maxLength": 128
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/modelEntry"
      },
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
      }
    },
    "start-with": {
      "type": "string",
      "description": "Name of the model entry to begin with."
    },
    "switch": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "router": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "power": {
          "enum": [
            "low",
            "medium",
            "max"
          ]
        },
        "prefer": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Exact model names tried in order first for the picking model."
        }
      }
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "$defs": {
    "modelEntry": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "power": {
          "enum": [
            "low",
            "medium",
            "max"
          ],
          "default": "medium"
        },
        "memory": {
          "enum": [
            "normal",
            "large",
            "huge",
            "vast"
          ],
          "default": "normal"
        },
        "thinking": {
          "enum": [
            "none",
            "some",
            "deep"
          ],
          "default": "none"
        },
        "sees-images": {
          "type": "boolean",
          "default": false
        },
        "uses-tools": {
          "type": "boolean",
          "default": false
        },
        "prefer": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Exact model names tried in order first. A wish, never a requirement."
        },
        "settings": {
          "$ref": "#/$defs/settings"
        },
        "description": {
          "type": "string",
          "description": "What kind of work this entry is for; read by the router."
        }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "effort": {
          "enum": [
            "off",
            "low",
            "medium",
            "high"
          ]
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "condition": {
      "description": "A bare keyword using its default, or a one-key map with the keyword's parameter.",
      "oneOf": [
        {
          "enum": [
            "planning",
            "stuck",
            "looping",
            "chat-full",
            "model-down"
          ]
        },
        {
          "type": "string",
          "pattern": "^x-[a-z0-9][a-z0-9-]*$"
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "planning": {
              "type": "string"
            },
            "stuck": {
              "type": "integer",
              "minimum": 1
            },
            "chat-full": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "spent-over": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "tokens-over": {
              "type": "integer",
              "minimum": 1
            },
            "turn-over": {
              "type": "integer",
              "minimum": 1
            }
          },
          "patternProperties": {
            "^x-[a-z0-9][a-z0-9-]*$": {}
          },
          "additionalProperties": false
        }
      ]
    },
    "rule": {
      "type": "object",
      "required": [
        "when",
        "use"
      ],
      "additionalProperties": false,
      "properties": {
        "when": {
          "oneOf": [
            {
              "$ref": "#/$defs/condition"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          ]
        },
        "use": {
          "type": "string"
        },
        "hold": {
          "type": "integer",
          "minimum": 0,
          "default": 3
        }
      }
    }
  }
}