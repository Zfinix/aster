# Rust
/target
**/*.rs.bk
Cargo.lock.orig

# Env / secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Editor / OS
.idea/
.vscode/
.DS_Store
paper/
web/
.githooks/

# VS Code extension: source is tracked, build output and packages are not.
editors/vscode/node_modules/
editors/vscode/out/
editors/vscode/media/webview/
editors/vscode/*.vsix

# Local
_archive/
.buildcache/
.mcp.json
