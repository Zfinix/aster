# Aster model configuration — any OpenAI-compatible provider.
# Copy to .env and fill in.

# Required: API key for your provider.
# A key named for the endpoint in use wins over this one, so you can keep
# ANTHROPIC_API_KEY, OPENAI_API_KEY, GROQ_API_KEY, MISTRAL_API_KEY,
# DEEPSEEK_API_KEY, GEMINI_API_KEY, OPEN_ROUTER_API_KEY, BASETEN_API_KEY,
# TOGETHER_API_KEY, CEREBRAS_API_KEY, and the rest exported at once and switch
# with `aster provider use <id>` without moving keys around.
# `aster models --providers` names the var each endpoint reads.
ASTER_API_KEY=

# Provider endpoint (OpenAI-compatible /chat/completions base).
# OpenRouter (default): https://openrouter.ai/api/v1
# Groq:                 https://api.groq.com/openai/v1
# OpenAI:               https://api.openai.com/v1
# Local llama.cpp:      http://localhost:8080/v1
ASTER_BASE_URL=https://openrouter.ai/api/v1

# Default model id (as your provider names it). Used for any pipeline stage
# that doesn't set its own override below.
ASTER_MODEL=openai/gpt-4o-mini

# Optional per-stage model overrides. Aster separates hypothesis (cheap,
# high-recall) from verification (independent, adversarial), so they can run on
# different models on the same provider. Unset = fall back to ASTER_MODEL.
# ASTER_HYPOTHESIS_MODEL=openai/gpt-4o-mini
# ASTER_VERIFY_MODEL=openai/gpt-4o

# Optional: repo name shown in the review summary.
ASTER_REPO=local

# Determinism + latency knobs (sensible defaults shown; override to taste).
# Reviews run at temperature 0 already; these make output reproducible and keep
# latency predictable on reasoning-capable models.
#   ASTER_SEED             fixed sampling seed (default 0; "off" to disable)
#   ASTER_MAX_TOKENS       cap generated tokens (default 8000; "0"/"off" = no cap)
#   ASTER_EFFORT           thinking budget: low|medium|high|off (default low;
#                          ASTER_REASONING_EFFORT is the older spelling)
#   ASTER_TIMEOUT_SECS     per-request timeout (default 120)
#   ASTER_MAX_RETRIES      retries on transient errors (default 3)
#   ASTER_DEADLINE_SECS    wall-clock cap across retries (default 180)
# ASTER_SEED=0
# ASTER_MAX_TOKENS=8000
# ASTER_EFFORT=low

# Agent knobs (defaults shown).
#   ASTER_MAX_TOOL_ROUNDS  tool calls in one turn before it must answer (60)
#   ASTER_COMMAND_TIMEOUT  seconds a single command may run (300)
#   ASTER_COMPACT_BUDGET   history chars kept before auto-compaction (192000)
#   ASTER_WEB_SEARCH       "1" turns review's web search back on (off)
#   ASTER_NO_BROWSER       set it and `open_preview`/`aster serve` never launch
#                          a browser; the URL is reported instead (unset)
#   ASTER_NO_UPDATE_CHECK  set it to skip the update check (unset)
# ASTER_MAX_TOOL_ROUNDS=60
# ASTER_COMMAND_TIMEOUT=300

# Review cost reporting (unset = a generic default price).
#   ASTER_VERIFY_CONCURRENCY      verify passes run at once (8)
#   ASTER_PRICE_PROMPT_PER_M      prompt price per million tokens
#   ASTER_PRICE_COMPLETION_PER_M  completion price per million tokens

# Web tools. `web/search` and `web/extract` work with none of these set:
# search falls through to DuckDuckGo, extraction to Jina Reader, then
# DuckDuckGo, then plain HTTP. A key upgrades the provider serving those tools, and unlocks
# `web/crawl`, `web/sitemap`, and `web/screenshot`. See docs/MCP.md.
#   EXA_API_KEY              neural search; leads `web/search`
#   PERPLEXITY_API_KEY       real-time ranked search; serves `web/search`
#   CONTEXT_DEV_API_KEY      extract, crawl, search, sitemap, screenshot
#   FIRECRAWL_API_KEY        extract, crawl, search
#   BROWSERBASE_API_KEY      extract, search
#   CLOUDFLARE_BR_ACCOUNT_ID + CLOUDFLARE_BR_API_TOKEN   extract, crawl
#   JINA_API_KEY             higher rate limits on the keyless extractor
# EXA_API_KEY=
# PERPLEXITY_API_KEY=
# CONTEXT_DEV_API_KEY=
# FIRECRAWL_API_KEY=
# BROWSERBASE_API_KEY=
# CLOUDFLARE_BR_ACCOUNT_ID=
# CLOUDFLARE_BR_API_TOKEN=
# JINA_API_KEY=

